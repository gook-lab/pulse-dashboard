# 백엔드 전용. 실제 키는 server/.env 에 넣으세요 (git 무시됨).
# 프론트엔드에는 절대 두지 마세요 — 모든 외부 API 호출은 백엔드가 대행합니다.

# 한국은행 ECOS — 환율·금리·경제지표 (무료, 즉시 발급)
ECOS_API_KEY=

# 공공데이터포털 data.go.kr — 전세·부동산 실거래가 (무료, 자동승인)
DATA_GO_KR_KEY=

# FRED (미 연준) — 미국 금리·유가·경제지표 (무료, 즉시)
FRED_API_KEY=

# Finnhub — 미국 주식 시세·뉴스 (무료 티어 60 calls/min)
FINNHUB_API_KEY=

# Alpha Vantage — 미국 시세·뉴스+감성 (무료 25 req/day)
ALPHAVANTAGE_API_KEY=

# 한국투자증권 KIS — 국내/해외 실시간 시세·계좌 (계좌+앱 등록 필요)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_MODE=mock   # mock(모의) | real(실전)
